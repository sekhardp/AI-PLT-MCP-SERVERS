# ==============================================================================
# AI-PLT MCP SERVERS - Environment Variables & Secrets Reference
# ==============================================================================
# Copy this file to `.env` for local Docker Compose or testing.
# In GCP Cloud Run:
#   - Set public configuration in Environment Variables (or Cloud Build substitutions).
#   - Set sensitive credentials (e.g. database connection string) in GCP Secret Manager.
# ==============================================================================

# --- Google Cloud Project & Location ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# --- RAG Server (rag-server) ---
# Secret in GCP Secret Manager: rag-db-url
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database>
RAG_DB_URL=postgresql+psycopg://postgres:your_password@your_db_host:5432/postgres
EMBEDDING_MODEL=text-embedding-005
EMBEDDING_TIMEOUT_SECONDS=5.0
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10
RAG_SERVER_PORT=8020

# --- BigQuery Server (bigquery-server) ---
BIGQUERY_SERVER_PORT=8030

# --- SGS BigQuery Server (sgs-bq-server) ---
SGS_BQ_SERVER_PORT=8040
BIGQUERY_PROJECT_ID=

# --- PPT Server (ppt-server) ---
PPT_SERVER_PORT=8050

# --- Registry Gateway (registry-gateway) ---
# Downstream SSE endpoint URLs
SERVER_RAG_SERVER_URL=http://rag-server:8080/sse
SERVER_BIGQUERY_SERVER_URL=http://bigquery-server:8080/sse
SERVER_SGS_BQ_SERVER_URL=http://sgs-bq-server:8080/sse
SERVER_PPT_SERVER_URL=http://ppt-server:8080/sse
REGISTRY_GATEWAY_PORT=8081
